# Backend
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
DATA_FILE=./backend/src/data/app-data.json
JWT_SECRET=replace-with-a-long-random-secret

# Frontend
# The unified frontend expects the backend at http://localhost:3000 by default.
# Override in the browser console with: localStorage.setItem('apiUrl', 'http://localhost:3000')
